/.metadata/
# Maven
target/        # Ignore the entire target directory generated by Maven builds
# Exclude the Maven wrapper JAR file from being ignored, so it can be used across environments
!/.mvn/wrapper/maven-wrapper.jar 
# Ignore maven-wrapper log/temp files
.mvn/wrapper/maven-wrapper.jar.options

# Spring Boot-specific
.apt_generated/
.sts4-cache/   # Cache files for Spring Tool Suite (STS)
logs/          # Log files and directories
*.log          # Specific log files
*.tmp

# IDE-specific (IntelliJ, Eclipse, VS Code)
.idea/         # IntelliJ IDEA project files
*.iml          # IntelliJ module files
*.iws
*.ipr
.classpath     # Eclipse project files
.project
.settings/
.factorypath
.vscode/       # VS Code settings

# Operating System files
.DS_Store      # macOS temporary files
Thumbs.db      # Windows thumbnail cache files

# Compiled files
*.class        # Compiled class files, usually covered by `target/`
*.jar          # Packaged JAR files, usually covered by `target/`
*.war

# Sensitive information/Environment variables
# Never commit credentials or sensitive configuration files
# Use environment variables or a separate, ignored configuration file for local secrets
.env
application-*.properties
application-*.yml
!src/main/resources/application.properties # ensure the default properties file is tracked
!src/main/resources/application.yml
